# Required for repository creation and Git pushes.
# Use a long random value: openssl rand -base64 32
ADMIN_TOKEN=change-me

# Public URL advertised in clone links. For local Docker use http://localhost.
# For production behind Caddy, use https://git.example.com.
PUBLIC_BASE_URL=http://localhost

# Caddy site address. Use http://localhost locally, or a real domain in production.
SITE_ADDRESS=http://localhost

# Bare repositories are stored here inside the app container.
GIT_ROOT=/data/repositories

# Optional: improves GitHub API rate limits for external read-only browsing.
GITHUB_TOKEN=
